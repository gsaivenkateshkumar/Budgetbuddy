# Copy this file to apps/api/.env (backend) and apps/web/.env.local (frontend)
# and fill in real values. Never commit actual secrets.

# ---------------------------------------------------------------------------
# Backend (apps/api) — FastAPI
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# SQLAlchemy database URL.
# Dev default (SQLite):    sqlite:///./budget_buddy.db
# Production (PostgreSQL): postgresql+psycopg://user:password@host:5432/budget_buddy
# A bare `postgres://` or `postgresql://` URL (as some managed providers hand
# out) is also accepted — normalized to the psycopg3 dialect automatically.
DATABASE_URL=sqlite:///./budget_buddy.db

# AI provider abstraction. "none" runs the app with AI features gracefully
# disabled (no external calls, no fabricated output).
# Supported: none | openai | anthropic | groq
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Auth
# JWT_SECRET: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Required in production — startup refuses to run with the insecure dev default.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS / linkage to the frontend origin(s). Comma-separated for more than one
# (e.g. a production domain plus a preview deployment).
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile (CAPTCHA) — protects /auth/register and /auth/login.
# Get a real site key + secret key from the Cloudflare dashboard (Turnstile
# product) for your domain. Optional at startup: if unset, verification
# fails closed (every login/register attempt is rejected) rather than
# silently skipping the check — set this before relying on auth in any
# environment. Never commit a real secret key.
#
# For local development ONLY, Cloudflare publishes non-secret test key
# pairs that are safe to put directly in a local .env (see
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   Always passes:  site key 1x00000000000000000000AA / secret key 1x0000000000000000000000000000000AA
#   Always blocks:  site key 2x00000000000000000000AB / secret key 2x0000000000000000000000000000000AA
#   Forces a visible challenge: site key 3x00000000000000000000FF
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Frontend (apps/web) — Next.js
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000

# The deployed frontend's own origin (e.g. the Vercel production URL) —
# used to resolve absolute URLs in metadata, robots.txt, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support/contact inbox shown on /contact and referenced from the legal
# pages. No real inbox exists yet — leave unset until one does; the site
# shows an honest "being finalized" message rather than a fabricated
# address. Set this once a real support email is available.
NEXT_PUBLIC_CONTACT_EMAIL=

# Cloudflare Turnstile site key for the /login and /register CAPTCHA
# widgets — this is the public counterpart of the backend's
# TURNSTILE_SECRET_KEY above (site keys are not secret, but still come
# from your own Cloudflare Turnstile dashboard entry). Use the matching
# test site key from the backend section above for local development.
# If unset, login/register show an honest "not configured" message
# instead of a broken widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only frontend secrets (no NEXT_PUBLIC_ prefix) go here if/when needed.

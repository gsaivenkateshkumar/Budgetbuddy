# Copy this file to apps/api/.env (backend) and apps/web/.env.local (frontend)
# and fill in real values. Never commit actual secrets.

# ---------------------------------------------------------------------------
# Backend (apps/api) — FastAPI
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# SQLAlchemy database URL.
# Dev default (SQLite):    sqlite:///./budget_buddy.db
# Production (PostgreSQL): postgresql+psycopg://user:password@host:5432/budget_buddy
# A bare `postgres://` or `postgresql://` URL (as some managed providers hand
# out) is also accepted — normalized to the psycopg3 dialect automatically.
DATABASE_URL=sqlite:///./budget_buddy.db

# AI provider abstraction. "none" runs the app with AI features gracefully
# disabled (no external calls, no fabricated output).
# Supported: none | openai | anthropic | groq
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Amazon Creators API (PA-API 5's official replacement — PA-API 5 was
# retired 2026-05-15). Optional: the app starts and runs fine without these,
# and Amazon ingestion (scripts/ingest_amazon.py) fails gracefully with a
# clear message if they're unset. Requires an approved Amazon Associates
# account — see docs/data-sources.md for eligibility requirements and how
# to obtain these.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in

# Auth
# JWT_SECRET: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Required in production — startup refuses to run with the insecure dev default.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS / linkage to the frontend origin(s). Comma-separated for more than one
# (e.g. a production domain plus a preview deployment).
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (apps/web) — Next.js
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000

# The deployed frontend's own origin (e.g. the Vercel production URL) —
# used to resolve absolute URLs in metadata, robots.txt, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support/contact inbox shown on /contact and referenced from the legal
# pages. No real inbox exists yet — leave unset until one does; the site
# shows an honest "being finalized" message rather than a fabricated
# address. Set this before the Cuelinks review, or any other public
# launch, once a real support email is available.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only frontend secrets (no NEXT_PUBLIC_ prefix) go here if/when needed.
